{
  "name": "ref-spa-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "resize-observer-polyfill": "^1.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  }
}
